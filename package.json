{
	"name": "@hsblabs/fetch-interceptor",
	"version": "0.2.0",
	"description": "Lightweight TypeScript library for intercepting browser fetch and XMLHttpRequest traffic.",
	"type": "module",
	"types": "./dist/index.d.ts",
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "pnpm lint && pnpm test:types && pnpm test && pnpm build",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm check && changeset publish",
		"prepublishOnly": "pnpm check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:types": "pnpm exec tsc --noEmit && pnpm --filter @hsblabs/fetch-interceptor-e2e test:types",
		"test:e2e": "pnpm --filter @hsblabs/fetch-interceptor-e2e test",
		"test:e2e:node": "pnpm --filter @hsblabs/fetch-interceptor-e2e test:node",
		"test:e2e:browser": "pnpm --filter @hsblabs/fetch-interceptor-e2e test:browser",
		"test:e2e:install": "pnpm --filter @hsblabs/fetch-interceptor-e2e install:browsers",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"keywords": [
		"fetch",
		"interceptor",
		"network",
		"browser",
		"typescript",
		"library",
		"xhr",
		"xmlhttprequest",
		"esm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hsblabs/fetch-interceptor.git"
	},
	"homepage": "https://github.com/hsblabs/fetch-interceptor#readme",
	"bugs": {
		"url": "https://github.com/hsblabs/fetch-interceptor/issues"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@changesets/cli": "^2.30.0",
		"@types/node": "^25.4.0",
		"tsdown": "^0.21.2",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"packageManager": "pnpm@10.32.1"
}
